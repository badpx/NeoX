function(neox_example target name library)
  add_executable(${target} examples/${target}.c)
  target_link_libraries(${target} PRIVATE ${library})
  neox_build_options(${target})
  if(NEOX_BUILD_TESTS)
    add_test(NAME ${name} COMMAND ${target})
    set_tests_properties(${name} PROPERTIES WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
  endif()
endfunction()
neox_example(ex01_scene ex01_smoke neox)
if(NEOX_ENABLE_GL)
  neox_example(ex02_gpuscene ex02_smoke neox)
endif()
if(NEOX_ENABLE_METAL)
  neox_example(ex03_mtlscene ex03_smoke neox)
endif()
if(NEOX_WITH_TEXT)
  neox_example(ex04_text ex04_smoke neox_text)
  neox_example(ex06_sdftext ex06_smoke neox_text)
endif()
if(NEOX_PRESENT)
  neox_example(ex05_window ex05_smoke neox_present)
  if(NEOX_BUILD_TESTS)
    set_tests_properties(ex05_smoke PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 60
      ENVIRONMENT "NEOX_PRESENT_FRAMES=2")
    if(APPLE AND NEOX_ENABLE_METAL)
      add_test(NAME ex05_metal_smoke COMMAND ex05_window)
      set_tests_properties(ex05_metal_smoke PROPERTIES TIMEOUT 60 SKIP_RETURN_CODE 77
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
        ENVIRONMENT "NEOX_PRESENT_FRAMES=2;NEOX_PRESENT_GPU=1")
    endif()
  endif()
endif()
