function(neox_test name target)
  add_executable(${target} tests/${target}.c ${ARGN})
  target_include_directories(${target} PRIVATE ${PROJECT_SOURCE_DIR}/src)
  target_link_libraries(${target} PRIVATE neox)
  neox_build_options(${target})
  add_test(NAME ${name} COMMAND ${target})
endfunction()
function(neox_gpu_test name target backend)
  add_test(NAME ${name} COMMAND ${target} ${backend})
  set_tests_properties(${name} PROPERTIES SKIP_RETURN_CODE 77)
endfunction()
neox_test(runtime test_runtime)
neox_test(memory_report test_memory_report)
neox_test(fixed_budget test_fixed_budget)
neox_test(geometry test_geometry)
neox_test(numeric_render_soft test_numeric_render)
neox_test(blend_matrix_soft test_blend_matrix)
neox_test(present_contracts test_present_contracts src/present.c)
target_compile_definitions(test_present_contracts PRIVATE NEOX_PRESENT_TEST_ADAPTERS=1)
if(UNIX)
  neox_test(egl_faults test_egl_faults)
  target_link_libraries(test_egl_faults PRIVATE ${CMAKE_DL_LIBS})
  neox_test(present_adapter_bounds test_present_adapter_bounds src/present.c)
  target_compile_definitions(test_present_adapter_bounds PRIVATE NEOX_PRESENT_TEST_ADAPTERS=1)
  target_link_libraries(test_present_adapter_bounds PRIVATE ${CMAKE_DL_LIBS})
endif()
if(NEOX_WITH_CAPTURE)
