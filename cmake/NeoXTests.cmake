  neox_test(semantics test_semantics)
  neox_test(clips_soft test_clips)
  if(NEOX_ENABLE_GL)
    neox_gpu_test(clips_gl test_clips gl)
  endif()
  if(NEOX_ENABLE_METAL)
    neox_gpu_test(clips_metal test_clips metal)
  endif()
  if(NEOX_ENABLE_GL OR NEOX_ENABLE_METAL)
    neox_test(gpu_consistency test_gpu_consistency)
    set_tests_properties(gpu_consistency PROPERTIES SKIP_RETURN_CODE 77)
  endif()
  if(NEOX_ENABLE_METAL)
    neox_gpu_test(gpu_consistency_metal_nodual test_gpu_consistency "")
    set_tests_properties(gpu_consistency_metal_nodual PROPERTIES ENVIRONMENT "NEOX_MTL_FORCE_NO_DUAL=1")
  endif()
  if(NEOX_ENABLE_GL)
    neox_gpu_test(gpu_consistency_nodual test_gpu_consistency "")
    neox_gpu_test(gpu_output_consistency test_gpu_consistency "")
    neox_gpu_test(gpu_output_consistency_nodual test_gpu_consistency "")
    set_tests_properties(gpu_consistency_nodual PROPERTIES ENVIRONMENT "NEOX_GL_FORCE_NO_DUAL=1")
    set_tests_properties(gpu_output_consistency PROPERTIES ENVIRONMENT "NEOX_TEST_GL_GPU_OUTPUT=1")
    set_tests_properties(gpu_output_consistency_nodual PROPERTIES ENVIRONMENT "NEOX_TEST_GL_GPU_OUTPUT=1;NEOX_GL_FORCE_NO_DUAL=1")
  endif()
endif()
